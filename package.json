{
  "name": "agent-development-lab",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@agent-dev-lab/web",
    "dev:docs": "turbo run dev --filter=@agent-dev-lab/docs",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.3.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "nitro": "npm:nitro-nightly@latest",
    "turbo": "^2.9.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.46.4"
  }
}
