{
  "name": "agent-development-lab",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@agent-dev-lab/web",
    "dev:cli": "turbo run dev --filter=@agent-dev-lab/cli",
    "dev:docs": "turbo run dev --filter=@agent-dev-lab/docs",
    "build": "turbo run build",
    "build:publish": "turbo run build --filter=@agent-dev-lab/core --filter=@agent-dev-lab/web --filter=@agent-dev-lab/cli",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "typecheck:publish": "turbo run typecheck --filter=@agent-dev-lab/core --filter=@agent-dev-lab/web --filter=@agent-dev-lab/cli",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@agent-dev-lab/cli",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "version-packages": "bun run version",
    "publish:packages": "bun run build:publish && changeset publish",
    "ci:publish": "bun run publish:packages"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@agent-dev-lab/core": "workspace:*",
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.3.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "nitro": "3.0.260610-beta",
    "prettier": "^3.8.3",
    "turbo": "^2.9.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.46.4"
  },
  "overrides": {
    "nitro": "3.0.260610-beta"
  }
}
