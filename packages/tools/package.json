{
  "name": "@agent-dev-lab/tools",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "ci:publish": "bash ../../scripts/ci-publish.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:node": "node --test src/bash/process-channel.test.ts src/bash/native-executor.test.ts src/bash/asrt/executor.test.ts src/file/search.executor.test.ts src/web/url-pattern.test.ts src/web/address-policy.test.ts src/web/fetch.test.ts src/web/fetch-url.test.ts"
  },
  "dependencies": {
    "@agent-dev-lab/core": "workspace:*",
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "ipaddr.js": "^2.5.0",
    "turndown": "^7.2.4",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^22.10.2",
    "@types/turndown": "^5.0.6",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.2"
  },
  "description": "Sandboxed file, bash, search, and fetchUrl tools for @agent-dev-lab/core",
  "author": "J. Simon Richard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsimonrichard/agent-dev-lab.git",
    "directory": "packages/tools"
  },
  "bugs": {
    "url": "https://github.com/jsimonrichard/agent-dev-lab/issues"
  },
  "homepage": "https://github.com/jsimonrichard/agent-dev-lab#readme",
  "keywords": [
    "ai",
    "agents",
    "tools",
    "sandbox",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  }
}
