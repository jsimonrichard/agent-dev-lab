{
  "name": "@agent-dev-lab/common",
  "version": "0.0.0",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "eslint.config.js",
    "tsconfig.node.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./eslint": "./eslint.config.js",
    "./tsconfig/node.json": "./tsconfig.node.json",
    "./db": {
      "types": "./src/db/index.ts",
      "bun": "./src/db/index.ts",
      "default": "./dist/db/index.js"
    },
    "./logging": {
      "types": "./src/logging/index.ts",
      "bun": "./src/logging/index.ts",
      "default": "./dist/logging/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.44.7",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.6",
    "typescript": "^6.0.2"
  },
  "description": "Shared Agent Dev Lab infrastructure — SQLite helpers, logging, ESLint config",
  "author": "J. Simon Richard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsimonrichard/agent-dev-lab.git",
    "directory": "packages/common"
  },
  "bugs": {
    "url": "https://github.com/jsimonrichard/agent-dev-lab/issues"
  },
  "homepage": "https://github.com/jsimonrichard/agent-dev-lab#readme",
  "keywords": [
    "sqlite",
    "drizzle",
    "logging",
    "eslint"
  ],
  "engines": {
    "node": ">=22"
  }
}
