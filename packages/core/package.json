{
  "name": "@agent-dev-lab/core",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./project": {
      "types": "./src/project/index.ts",
      "bun": "./src/project/index.ts",
      "default": "./dist/project/index.js"
    },
    "./result": {
      "types": "./src/result.ts",
      "bun": "./src/result.ts",
      "import": "./src/result.ts",
      "default": "./dist/result.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@agent-dev-lab/common": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "ai": "^5.0.86",
    "handlebars": "^4.7.8",
    "jiti": "^2.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.10.2",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.2",
    "unrun": "^0.3.1"
  }
}
