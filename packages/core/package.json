{
  "name": "@agent-dev-lab/core",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "eslint.config.js",
    "tsconfig.node.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./project": {
      "types": "./src/project/index.ts",
      "bun": "./src/project/index.ts",
      "development": "./src/project/index.ts",
      "default": "./dist/project/index.js"
    },
    "./result": {
      "types": "./src/result.ts",
      "bun": "./src/result.ts",
      "import": "./src/result.ts",
      "default": "./dist/result.js"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "bun": "./src/db/index.ts",
      "development": "./src/db/index.ts",
      "default": "./dist/db/index.js"
    },
    "./logging": {
      "types": "./src/logging/index.ts",
      "bun": "./src/logging/index.ts",
      "development": "./src/logging/index.ts",
      "default": "./dist/logging/index.js"
    },
    "./eslint": "./eslint.config.js",
    "./tsconfig/node.json": "./tsconfig.node.json"
  },
  "scripts": {
    "build": "tsdown",
    "ci:publish": "bash ../../scripts/ci-publish.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/better-sqlite3": "^9.6.0",
    "ai": "^5.0.86",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.44.7",
    "handlebars": "^4.7.8",
    "jiti": "^2.7.0",
    "pino": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.6",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.2",
    "unrun": "^0.3.1"
  },
  "description": "Headless Agent Dev Lab runtime — agents, workflows, templates, and stores on the Vercel AI SDK",
  "author": "J. Simon Richard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsimonrichard/agent-dev-lab.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/jsimonrichard/agent-dev-lab/issues"
  },
  "homepage": "https://github.com/jsimonrichard/agent-dev-lab#readme",
  "keywords": [
    "ai",
    "agents",
    "workflows",
    "vercel-ai-sdk",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  }
}
