{
  "extends": "@agent-dev-lab/core/tsconfig/node.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/*.test.ts", "e2e", "playwright.config.ts", "test-results", "playwright-report"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
