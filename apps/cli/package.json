{
  "name": "@agent-dev-lab/cli",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Agent Development Lab command-line interface",
  "type": "module",
  "bin": {
    "adl": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/bin/cli.ts",
    "prebuild": "bun run verify:web-output && tsc -p tsconfig.json --noEmit",
    "build": "tsup --silent && bun run package-scaffold",
    "package-scaffold": "bun run scripts/package-scaffold.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "verify:web-output": "bun run scripts/verify-web-output.ts",
    "test": "bun test src",
    "test:e2e": "bun test src/e2e"
  },
  "dependencies": {
    "@agent-dev-lab/core": "workspace:*",
    "@agent-dev-lab/web": "workspace:*",
    "@stricli/core": "^1.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "@types/bun": "^1.3.13"
  },
  "tsup": {
    "entry": [
      "src/bin/cli.ts"
    ],
    "format": [
      "esm"
    ],
    "tsconfig": "tsconfig.json",
    "clean": true,
    "splitting": true,
    "minify": false,
    "target": "node22",
    "external": [
      "@agent-dev-lab/core",
      "@agent-dev-lab/core/project"
    ]
  },
  "author": "J. Simon Richard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsimonrichard/agent-dev-lab.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/jsimonrichard/agent-dev-lab/issues"
  },
  "homepage": "https://github.com/jsimonrichard/agent-dev-lab#readme",
  "keywords": [
    "cli",
    "adl",
    "agents",
    "workflows"
  ],
  "engines": {
    "node": ">=22"
  }
}
