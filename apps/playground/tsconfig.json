{
  "extends": "@agent-dev-lab/core/tsconfig/node.json",
  "compilerOptions": {
    "paths": {
      "#adl": ["./src/adl.ts"]
    },
    "noEmit": true,
    "types": ["bun"],
    // @agent-dev-lab/tools' `bun`/`development` conditions still point at source (explicit
    // `.ts` import specifiers). Typecheck resolves the `types` condition (`dist/*.d.ts`).
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts"]
}
